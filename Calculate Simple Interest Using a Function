
function calculateSimpleInterest(principal, rate, time) {
    let interest = (principal * rate * time) / 100;
    return interest;
}

// First set of values
console.log(
    "Simple Interest 1:",
    calculateSimpleInterest(1000, 5, 2)
);

// Second set of values
console.log(
    "Simple Interest 2:",
    calculateSimpleInterest(2000, 4, 3)
);

// Third set of values
console.log(
    "Simple Interest 3:",
    calculateSimpleInterest(5000, 6, 1)
);
